services:
  gateway:
    build:
      context: .
      dockerfile: services/server/gateway/Dockerfile
      target: dev
    container_name: tic-tac-toe-gateway
    env_file:
      - services/server/gateway/.env
    ports:
      - "9090:9090"
    volumes:
      - ./shared:/usr/src/app/shared
      - ./turbo.json:/usr/src/app/turbo.json:ro
      - ./services/server/gateway/src:/usr/src/app/services/server/gateway/src/
      - ./services/server/gateway/package.json:/usr/src/app/services/server/gateway/package.json
    command: pnpm exec turbo run dev --filter gateway
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:9090/gateway/livez || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  auth:
    build:
      context: .
      dockerfile: services/server/auth/Dockerfile
      target: dev
    container_name: tic-tac-toe-auth
    env_file:
      - services/server/auth/.env
    environment:
      KAFKAJS_NO_PARTITIONER_WARNING: 1
    volumes:
      - ./shared:/usr/src/app/shared
      - /usr/src/app/shared/cache-store/node_modules
      - /usr/src/app/shared/errors/node_modules
      - /usr/src/app/shared/grpc-client-manager/node_modules
      - /usr/src/app/shared/kafka-manager/node_modules
      - /usr/src/app/shared/logger/node_modules
      - /usr/src/app/shared/otel/node_modules
      - /usr/src/app/shared/persistent-logger/node_modules
      - /usr/src/app/shared/pg-boss-manager/node_modules
      - /usr/src/app/shared/state-store/node_modules
      - /usr/src/app/shared/timer/node_modules
      - ./services/server/auth/src:/usr/src/app/services/server/auth/src/
      - ./services/server/auth/package.json:/usr/src/app/services/server/auth/package.json
    depends_on:
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter auth
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  orchestration:
    build:
      context: .
      dockerfile: services/server/orchestration/Dockerfile
      target: dev
    container_name: tic-tac-toe-orchestration
    env_file:
      - services/server/orchestration/.env
    volumes:
      - ./shared:/usr/src/app/shared
      - /usr/src/app/shared/cache-store/node_modules
      - /usr/src/app/shared/errors/node_modules
      - /usr/src/app/shared/grpc-client-manager/node_modules
      - /usr/src/app/shared/kafka-manager/node_modules
      - /usr/src/app/shared/logger/node_modules
      - /usr/src/app/shared/otel/node_modules
      - /usr/src/app/shared/persistent-logger/node_modules
      - /usr/src/app/shared/pg-boss-manager/node_modules
      - /usr/src/app/shared/state-store/node_modules
      - /usr/src/app/shared/timer/node_modules
      - ./services/server/orchestration/src:/usr/src/app/services/server/orchestration/src/
      - ./services/server/orchestration/package.json:/usr/src/app/services/server/orchestration/package.json
    depends_on:
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter orchestration
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  bot:
    build:
      context: .
      dockerfile: services/server/bot/Dockerfile
      target: dev
    container_name: tic-tac-toe-bot
    env_file:
      - services/server/bot/.env
    environment:
      ELASTICSEARCH_USERNAME: elastic
      ELASTICSEARCH_PASSWORD: ${ELASTIC_PASSWORD:-changeme}
    volumes:
      - ./shared:/usr/src/app/shared
      - /usr/src/app/shared/cache-store/node_modules
      - /usr/src/app/shared/errors/node_modules
      - /usr/src/app/shared/grpc-client-manager/node_modules
      - /usr/src/app/shared/kafka-manager/node_modules
      - /usr/src/app/shared/logger/node_modules
      - /usr/src/app/shared/otel/node_modules
      - /usr/src/app/shared/persistent-logger/node_modules
      - /usr/src/app/shared/pg-boss-manager/node_modules
      - /usr/src/app/shared/state-store/node_modules
      - /usr/src/app/shared/timer/node_modules
      - ./services/server/bot/__tests__:/usr/src/app/services/server/bot/__tests__/
      - ./services/server/bot/src:/usr/src/app/services/server/bot/src/
      - ./services/server/bot/package.json:/usr/src/app/services/server/bot/package.json
    depends_on:
      pgbouncer:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter bot
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  battle:
