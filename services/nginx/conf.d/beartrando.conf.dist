server {
    listen 80;
    server_name beartrando.org www.beartrando.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name beartrando.org www.beartrando.org;

    ssl_certificate     /etc/letsencrypt/live/beartrando.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/beartrando.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}
