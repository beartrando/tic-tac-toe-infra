  streaming:
    build:
      context: .
      dockerfile: services/server/streaming/Dockerfile
      target: dev
    container_name: tic-tac-toe-streaming
    env_file:
      - services/server/streaming/.env
    environment:
      ELASTICSEARCH_USERNAME: elastic
      ELASTICSEARCH_PASSWORD: ${ELASTIC_PASSWORD:-changeme}
    ports:
      - "8080:8080"
    volumes:
      - ./shared:/usr/src/app/shared
      - /usr/src/app/shared/cache-store/node_modules
      - /usr/src/app/shared/errors/node_modules
      - /usr/src/app/shared/grpc-client-manager/node_modules
      - /usr/src/app/shared/kafka-manager/node_modules
      - /usr/src/app/shared/logger/node_modules
      - /usr/src/app/shared/otel/node_modules
      - /usr/src/app/shared/persistent-logger/node_modules
      - /usr/src/app/shared/pg-boss-manager/node_modules
      - /usr/src/app/shared/state-store/node_modules
      - /usr/src/app/shared/timer/node_modules
      - ./services/server/streaming/src:/usr/src/app/services/server/streaming/src/
      - ./services/server/streaming/package.json:/usr/src/app/services/server/streaming/package.json
    command: pnpm dlx turbo run dev --parallel --filter streaming
    extra_hosts: *platform-hosts
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  profile:
    build:
      context: .
      dockerfile: services/server/profile/Dockerfile
      target: dev
    container_name: tic-tac-toe-profile
    env_file:
      - services/server/profile/.env
    volumes:
      - ./shared:/usr/src/app/shared
      - /usr/src/app/shared/cache-store/node_modules
      - /usr/src/app/shared/errors/node_modules
      - /usr/src/app/shared/grpc-client-manager/node_modules
      - /usr/src/app/shared/kafka-manager/node_modules
      - /usr/src/app/shared/logger/node_modules
      - /usr/src/app/shared/otel/node_modules
      - /usr/src/app/shared/persistent-logger/node_modules
      - /usr/src/app/shared/pg-boss-manager/node_modules
      - /usr/src/app/shared/state-store/node_modules
      - /usr/src/app/shared/timer/node_modules
      - ./services/server/profile/src:/usr/src/app/services/server/profile/src/
      - ./services/server/profile/package.json:/usr/src/app/services/server/profile/package.json
    command: pnpm dlx turbo run dev --parallel --filter profile
    extra_hosts: *platform-hosts
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  engine:
    build:
      context: .
      dockerfile: services/server/engine/Dockerfile
      target: dev
    container_name: tic-tac-toe-engine
    env_file:
      - services/server/engine/.env
    environment:
      ELASTICSEARCH_USERNAME: elastic
      ELASTICSEARCH_PASSWORD: ${ELASTIC_PASSWORD:-changeme}
    volumes:
      - ./shared:/usr/src/app/shared
      - /usr/src/app/shared/cache-store/node_modules
      - /usr/src/app/shared/errors/node_modules
      - /usr/src/app/shared/grpc-client-manager/node_modules
      - /usr/src/app/shared/kafka-manager/node_modules
      - /usr/src/app/shared/logger/node_modules
      - /usr/src/app/shared/otel/node_modules
      - /usr/src/app/shared/persistent-logger/node_modules
      - /usr/src/app/shared/pg-boss-manager/node_modules
      - /usr/src/app/shared/state-store/node_modules
      - /usr/src/app/shared/timer/node_modules
      - ./services/server/engine/src:/usr/src/app/services/server/engine/src/
      - ./services/server/engine/package.json:/usr/src/app/services/server/engine/package.json
    depends_on:
      redis:
        condition: service_healthy
    command: pnpm dlx turbo run dev --parallel --filter engine
    extra_hosts: *platform-hosts
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  #  service-template:
  #    build:
  #      context: .
  #      dockerfile: services/infra/service-template/Dockerfile
  #      target: dev
  #    container_name: tic-tac-toe-service-template
  #    env_file:
  #      - services/infra/service-template/.env
  #    environment:
  #      KAFKAJS_NO_PARTITIONER_WARNING: 1
