{
  "name": "@shared/errors",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "proto:generate": "pnpm exec protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/contracts/proto --ts_proto_opt=outputServices=none,useExactTypes=false,esModuleInterop=true --proto_path=../../proto/ ../../proto/common/error.proto"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "ts-proto": "^2.11.6"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "files": [
    "dist"
  ]
}

