  #      interval: 10s
  #      timeout: 5s
  #      retries: 10
  #      start_period: 20s

  infrastructure-telemetry-mcp:
    build:
      context: .
      dockerfile: services/infra/infrastructure-telemetry-mcp/Dockerfile
      target: dev
    container_name: tic-tac-toe-infrastructure-telemetry-mcp
    env_file:
      - services/infra/infrastructure-telemetry-mcp/.env
    environment:
      KAFKAJS_NO_PARTITIONER_WARNING: 1
      PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN: "false"
    volumes:
      - ./shared:/usr/src/app/shared
      - ./services/infra/infrastructure-telemetry-mcp/src:/usr/src/app/services/infra/infrastructure-telemetry-mcp/src/
      - ./services/infra/infrastructure-telemetry-mcp/package.json:/usr/src/app/services/infra/infrastructure-telemetry-mcp/package.json
    command: pnpm --filter infrastructure-telemetry-mcp dev
    extra_hosts: *platform-hosts
    networks:
      - backend
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:3000/health || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  opentelemetry-collector:
    image: otel/opentelemetry-collector-contrib:0.112.0
    container_name: tic-tac-toe-opentelemetry-collector
    user: "0:0"  # distroless-образ (uid 10001) не может писать очередь в volume
    command: ["--config=/etc/otel-collector-config.yaml"]
    volumes:
      - ./services/observability/otel-collector/config.yaml:/etc/otel-collector-config.yaml:ro
      - otel_queue:/var/lib/otelcol
    ports:
      - "4318:4318"
    extra_hosts: *platform-hosts
    networks:
      - backend
    healthcheck:
      disable: true

  redis:
    image: redis:7.2
    container_name: tic-tac-toe-redis
    restart: always
    networks:
      - backend
    healthcheck:
      test: [ "CMD", "redis-cli", "ping" ]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  otel_queue:

networks:
  backend:
    driver: bridge
