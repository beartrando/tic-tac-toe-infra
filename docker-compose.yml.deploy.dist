services:
  gateway:
    container_name: tic-tac-toe-gateway
image: ghcr.io/beartrando/tic-tac-toe-gateway/service:${GATEWAY_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.gateway
    ports:
      - "9090:9090"
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:9090/gateway/livez || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  auth:
    container_name: tic-tac-toe-auth
    image: ghcr.io/beartrando/tic-tac-toe-auth/service:${AUTH_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.auth
    environment:
      KAFKAJS_NO_PARTITIONER_WARNING: 1
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  orchestration:
    container_name: tic-tac-toe-orchestration
    image: ghcr.io/beartrando/tic-tac-toe-orchestration/service:${ORCHESTRATION_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.orchestration
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  bot:
    container_name: tic-tac-toe-bot
    image: ghcr.io/beartrando/tic-tac-toe-bot/service:${BOT_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.bot
    environment:
      ELASTICSEARCH_USERNAME: elastic
      ELASTICSEARCH_PASSWORD: ${ELASTIC_PASSWORD:-changeme}
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  battle:
    container_name: tic-tac-toe-battle
    image: ghcr.io/beartrando/tic-tac-toe-battle/service:${BATTLE_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.battle
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  matchmaking:
    container_name: tic-tac-toe-matchmaking
    image: ghcr.io/beartrando/tic-tac-toe-matchmaking/service:${MATCHMAKING_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.matchmaking
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  streaming:
    container_name: tic-tac-toe-streaming
    image: ghcr.io/beartrando/tic-tac-toe-streaming/service:${STREAMING_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.streaming
    depends_on:
      pgbouncer:
        condition: service_healthy
    ports:
      - "8080:8080"
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  profile:
    container_name: tic-tac-toe-profile
    image: ghcr.io/beartrando/tic-tac-toe-profile/service:${PROFILE_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.profile
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  engine:
    container_name: tic-tac-toe-engine
    image: ghcr.io/beartrando/tic-tac-toe-engine/service:${ENGINE_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.engine
    environment:
      ELASTICSEARCH_USERNAME: elastic
      ELASTICSEARCH_PASSWORD: ${ELASTIC_PASSWORD:-changeme}
    depends_on:
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:50051 || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  infrastructure-telemetry-mcp:
    container_name: tic-tac-toe-infrastructure-telemetry-mcp
    image: ghcr.io/beartrando/infrastructure-telemetry-mcp/service:${INFRASTRUCTURE_TELEMETRY_MCP_VERSION:-${DEFAULT_VERSION}}
    restart: unless-stopped
    env_file:
      - ./services/.env.infrastructure-telemetry-mcp
    depends_on:
      pgbouncer:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: [ "CMD-SHELL", "wget -q --spider http://127.0.0.1:3000/health || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  opentelemetry-collector:
    image: otel/opentelemetry-collector-contrib:0.112.0
    container_name: tic-tac-toe-opentelemetry-collector
    restart: unless-stopped
    command: ["--config=/etc/otel-collector-config.yaml"]
    volumes:
      - ./services/observability/otel-collector/config.yaml:/etc/otel-collector-config.yaml:ro
    ports:
      - "4318:4318"
    networks:
      backend:
        aliases:
          - tempo
          - prometheus
    healthcheck:
      test: ["CMD", "/otelcol-contrib", "validate", "--config=/etc/otel-collector-config.yaml"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  postgres:
    image: postgres:17.6
    container_name: tic-tac-toe-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
      POSTGRES_INITDB_ARGS: "--auth-host=md5"
    volumes:
      - ./services/infra/postgres/data:/var/lib/postgresql/data
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s

  pgbouncer:
    image: edoburu/pgbouncer
    container_name: tic-tac-toe-pgbouncer
    restart: unless-stopped
    volumes:
      - ./services/infra/pgbouncer/userlist.txt:/etc/pgbouncer/userlist.txt
      - ./services/infra/pgbouncer/pgbouncer.ini:/etc/pgbouncer/pgbouncer.ini
    tmpfs:
      - /var/run/pgbouncer:uid=70,gid=70,mode=0755
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -h postgres -p 5432"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  redis:
    image: redis:7.2
    container_name: tic-tac-toe-redis
    restart: unless-stopped
    networks:
      - backend
      - platform_infra
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

networks:
  backend:
    driver: bridge
  platform_infra:
    external: true
    name: platform_infra
